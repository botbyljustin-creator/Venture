# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (https://app.supabase.com → Project Settings → API) ───────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (https://console.anthropic.com) ───────────────────────────
ANTHROPIC_API_KEY=
# Optional model overrides — see lib/ai/models.ts for defaults.
ANTHROPIC_MODEL_ANALYSIS=claude-sonnet-5
ANTHROPIC_MODEL_CLASSIFICATION=claude-haiku-4-5-20251001

# ── Stripe (https://dashboard.stripe.com/apikeys) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_LAUNCH_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# ── Email (https://resend.com/api-keys) ─────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="VentureForge <noreply@ventureforge.app>"

# ── Analytics (optional) ─────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Admin ─────────────────────────────────────────────────────────────
# Comma-separated list of emails granted admin dashboard access.
ADMIN_EMAILS=you@example.com
